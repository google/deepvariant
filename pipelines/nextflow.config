/*
    Nextflow Configuration for DeepVariant Open-Source Pipeline
    ===========================================================

    This file provides configuration profiles for running the DeepVariant
    pipeline.

    For more details on Nextflow configuration, visit:
    https://www.nextflow.io/docs/latest/config.html

    PROFILES:
    ---------
    Select a profile using the `-profile` flag:
    
    1. Local Execution (Default):
       `NXF_VER=25.04.2 nextflow run pipelines/deepvariant_nf/deepvariant.nf -profile local ...`
    
    2. Google Cloud Batch Execution:
       `NXF_VER=25.04.2 nextflow run pipelines/deepvariant_nf/deepvariant.nf -profile gcs ...`

    CUSTOMIZATION:
    --------------
    For the `gcs` profile, you MUST replace the placeholders (e.g., `<YOUR_PROJECT_ID>`)
    with your actual Google Cloud details.
*/

// Default parameters
params.check_for_errors = true
params.gpu = false

// Enable Docker globally
docker {
    enabled = true
    fixOwnership = true
    runOptions = '-u $(id -u):$(id -g)' // Ensure output files are owned by the current user
}

profiles {

    // Local execution profile (Default)
    local {
        process {
            executor = 'local'
            
            // Cap resource requests at the physical limits of the local host.
            // This prevents Nextflow from attempting to request more CPUs or Memory
            // than the machine actually has, automatically scaling down high defaults.
            resourceLimits = [
                cpus: Runtime.getRuntime().availableProcessors(),
                memory: getMemory(),
                time: 24.h
            ]

            // Default resource limits (high defaults, will be capped by resourceLimits if needed)
            cpus = 8
            memory = '32 GB'

            // Resource allocations for specific process labels (auto-capped by resourceLimits)
            withLabel: xs {
                cpus = 1
                memory = '4 GB'
            }

            withLabel: sm {
                cpus = 2
                memory = '8 GB'
            }

            withLabel: md {
                cpus = 4
                memory = '16 GB'
            }

            withLabel: lg {
                cpus = 8
                memory = '32 GB'
            }

            withLabel: xl {
                cpus = 16
                memory = '64 GB'
            }

            withLabel: xxl {
                cpus = 16
                memory = '64 GB'
            }
        }
    }

    // Google Cloud Batch execution profile
    gcs {
        workDir = 'gs://<YOUR_GCS_BUCKET>/work'

        process {
            executor = 'google-batch'
            
            // Resource allocations matching Google Cloud machine types
            // We explicitly set cpus and memory so Nextflow can correctly
            // determine shard numbers (e.g. --num_shards ${task.cpus})
            withLabel: xs {
                machineType = 'e2-standard-2'
                cpus = 2
                memory = '8 GB'
            }

            withLabel: sm {
                machineType = 'e2-standard-8'
                cpus = 8
                memory = '32 GB'
            }

            withLabel: md {
                machineType = 'e2-standard-16'
                cpus = 16
                memory = '64 GB'
            }

            withLabel: lg {
                machineType = 'e2-standard-32'
                cpus = 32
                memory = '128 GB'
            }

            withLabel: xl {
                machineType = 'n2-standard-96'
                cpus = 96
                memory = '384 GB'
            }

            withLabel: xxl {
                machineType = 'n2-standard-96'
                cpus = 96
                memory = '384 GB'
            }
        }

        google {
            // REPLACE THESE WITH YOUR ACTUAL GCP DETAILS
            project = '<YOUR_GCP_PROJECT_ID>'
            location = '<YOUR_GCP_REGION>' // e.g., 'us-central1'

            batch {
                serviceAccountEmail = '<YOUR_SERVICE_ACCOUNT_EMAIL>'
                installGpuDrivers = true
            }
        }
    }
}

// Capture pipeline execution reports
report {
    enabled = true
    file = 'pipeline_report.html'
    overwrite = true
}

trace {
    enabled = true
    file = 'pipeline_trace.txt'
    overwrite = true
}

timeline {
    enabled = true
    file = 'pipeline_timeline.html'
    overwrite = true
}

def getMemory() {
    try {
        def mxbean = java.lang.management.ManagementFactory.getOperatingSystemMXBean()
        def method = null
        try {
            method = mxbean.class.getMethod("getTotalMemorySize")
        } catch (NoSuchMethodException e) {
            method = mxbean.class.getMethod("getTotalPhysicalMemorySize")
        }
        long mem = (long) method.invoke(mxbean)
        def gb = Math.floor(mem / (1024 * 1024 * 1024)) as int
        return "${gb} GB"
    } catch (Exception e) {
        return "10 GB"
    }
}
